DATABASE_URL=
JWT_SECRET=
WEB_ORIGIN=

# Optional: Telegram Emergency SOS (set both or neither)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production hardening. ENVIRONMENT=production (implied on Render when unset) requires a
# JWT_SECRET of 32+ random characters, an https:// WEB_ORIGIN, and a non-SQLite DATABASE_URL,
# turns on Secure cookies, hides /docs, and refuses to start while demo accounts are active.
ENVIRONMENT=
# Optional overrides: COOKIE_SECURE=true|false, ENABLE_API_DOCS=true|false
# Optional: bearer token for /metrics (in production /metrics is disabled without it)
METRICS_TOKEN=
